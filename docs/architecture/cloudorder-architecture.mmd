flowchart LR
  customer["Customer / future web client"]
  admin["Admin client"]

  subgraph aws["AWS Cloud | CloudOrder production architecture"]
    subgraph edge["Identity and ingress"]
      cognito["Amazon Cognito\nJWT identity"]
      alb["Application Load Balancer\nHTTPS / TLS"]
    end

    subgraph vpc["VPC | public ingress, private application and data subnets"]
      subgraph app["Private application tier"]
        api["ECS Fargate service\nDjango + DRF + Strawberry"]
        publisher["Outbox publisher\nECS process"]
      end
      subgraph postgres["Private data tier"]
        rds[("Amazon RDS PostgreSQL\norders | order_items | outbox_events")]
      end
    end

    ecr["Amazon ECR\nAPI and Lambda container images"]

    subgraph events["Event-driven order processing"]
      eb["Amazon EventBridge\nOrder event bus"]
      queue["Amazon SQS\nwork queue"]
      dlq["Amazon SQS\nDLQ"]
      starter["Starter Lambda\nvalidate + start execution"]
      sfn["AWS Step Functions\nStandard workflow"]
      tasks["Workflow task Lambdas\nvalidate | inventory | payment\ncomplete | invoice | notify"]
    end

    subgraph persistence["Workflow and document data"]
      ddb[("Amazon DynamoDB\nOrderProcessing\nworkflow + idempotency")]
      s3[("Private Amazon S3 bucket\nPDF invoices | SSE-KMS")]
    end

    subgraph messaging["Customer notifications"]
      sns["Amazon SNS\nemail / SMS notification"]
      recipient["Customer notification endpoint"]
    end

    subgraph security["Security and operations"]
      iam["IAM least-privilege roles\nECS | publisher | Lambdas | Step Functions"]
      secrets["AWS Secrets Manager\nDB credentials"]
      kms["AWS KMS\nRDS | S3 | SQS | SNS | DynamoDB"]
      cw["Amazon CloudWatch\nlogs | metrics | alarms | traces"]
    end
  end

  customer -->|"1. Sign in, receive JWT"| cognito
  admin -->|"1. Admin sign in, receive JWT"| cognito
  customer -->|"2. HTTPS + bearer JWT: REST / GraphQL"| alb
  admin -->|"2. HTTPS + bearer JWT: REST / GraphQL"| alb
  alb -->|"3. Forward requests"| api
  ecr -->|"Container image pull"| api
  ecr -->|"Container image pull"| tasks
  api -->|"4. Verify JWT claims and authorize owner/admin"| cognito
  api -->|"5. Atomic order + items + outbox transaction"| rds
  publisher -->|"6. Poll unpublished outbox rows"| rds
  publisher -->|"7. Publish OrderCreated"| eb
  eb -->|"8. Route matching event"| queue
  queue -->|"9. Deliver at least once"| starter
  starter -->|"10. Start execution with stable order key"| sfn
  starter -->|"Read/write execution dedupe record"| ddb
  sfn -->|"11. Run ordered tasks; retry transient failures"| tasks
  tasks -->|"12. Conditional idempotency/workflow updates"| ddb
  tasks -->|"13. Guarded status/version updates; source of truth"| rds
  tasks -->|"14. Store generated PDF; persist invoice key"| s3
  tasks -->|"15. Publish order result notification"| sns
  sns -->|"16. Deliver notification"| recipient
  queue -.->|"After retry limit"| dlq
  dlq -->|"Visible backlog / age alarms"| cw

  api -.->|"Runtime DB secret"| secrets
  publisher -.->|"Runtime DB secret"| secrets
  tasks -.->|"Runtime DB secret"| secrets
  iam -.->|"Scoped permissions"| api
  iam -.->|"Scoped permissions"| publisher
  iam -.->|"Scoped permissions"| starter
  iam -.->|"Scoped permissions"| tasks
  iam -.->|"Scoped permissions"| sfn
  kms -.->|"Encryption at rest"| rds
  kms -.->|"Encryption at rest"| ddb
  kms -.->|"Encryption at rest"| s3
  kms -.->|"Encryption at rest"| queue
  api -.->|"Structured logs / metrics"| cw
  publisher -.->|"Publish and retry metrics"| cw
  starter -.->|"Invocation/errors"| cw
  sfn -.->|"Execution history / alarms"| cw
  tasks -.->|"Task logs / metrics"| cw

  classDef client fill:#f4f1e8,stroke:#766b52,color:#20231f,stroke-width:1.5px
  classDef identity fill:#e7f2ef,stroke:#327366,color:#173b35,stroke-width:1.5px
  classDef compute fill:#e8eff8,stroke:#426b97,color:#1a324b,stroke-width:1.5px
  classDef database fill:#f7ecdb,stroke:#a5712d,color:#4b3316,stroke-width:1.5px
  classDef events fill:#f5e8e4,stroke:#ae5945,color:#4a241d,stroke-width:1.5px
  classDef security fill:#e9e9e5,stroke:#5a625b,color:#252a26,stroke-width:1.5px
  class customer,admin,recipient client
  class cognito,alb identity
  class api,publisher,starter,sfn,tasks compute
  class rds,ddb,s3 database
  class eb,queue,dlq,sns events
  class iam,secrets,kms,cw security
